{
  "name": "@react-flow-ui-engine/core",
  "version": "0.3.0",
  "description": "Framework-agnostic flow engine for UI journeys, wizards, onboarding, and conditional screens.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "flow-engine",
    "workflow",
    "state-machine",
    "wizard",
    "onboarding",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR_GITHUB_USERNAME/react-flow-ui-engine.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/YOUR_GITHUB_USERNAME/react-flow-ui-engine/issues"
  },
  "homepage": "https://github.com/YOUR_GITHUB_USERNAME/react-flow-ui-engine#readme",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
