{
  "name": "@react-flow-ui-engine/react",
  "version": "0.3.0",
  "description": "React bindings for react-flow-ui-engine: render declarative user journeys, wizards, and onboarding flows.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "react",
    "flow-engine",
    "wizard",
    "onboarding",
    "conditional-ui",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/react-flow-ui-engine/react-flow-ui-engine.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/react-flow-ui-engine/react-flow-ui-engine/issues"
  },
  "homepage": "https://github.com/react-flow-ui-engine/react-flow-ui-engine#readme",
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --clean --external react",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@react-flow-ui-engine/core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
